<jube>
  <common_setup>
    <parameterset name="param_environment">
      <parameter name="CC" export="true">clang</parameter>
      <parameter name="OMPI_CC" export="true">clang</parameter>
      <parameter name="MPICH_CC" export="true">clang</parameter>
      <parameter name="OSHMEM_CC" export="true">clang</parameter>
      <parameter name="SHMEM_CC" export="true">clang</parameter>
      <parameter name="CXX" export="true">clang++</parameter>
      <parameter name="OMPI_CXX" export="true">clang++</parameter>
      <parameter name="MPICH_CXX" export="true">clang++</parameter>
      <parameter name="OSHMEM_CXX" export="true">clang++</parameter>
      <parameter name="SHMEM_CXX" export="true">clang++</parameter>
      <parameter name="PMIX_MCA_gds" export="true">hash</parameter>
      <parameter name="PMIX_MCA_psec" export="true">^munge</parameter>
      <parameter name="UCX_MEM_MMAP_HOOK_MODE" export="true">none</parameter>
      <parameter name="OMPI_MCA_memory" export="true">^patcher</parameter>
      <parameter name="MODULE_CLEANUP">
        module purge
        spack unload --all
        module use /home/yo30qaqy/modules
      </parameter>
      <parameter name="MODULE_LOAD" tag="ompi4">
        echo "Loading ompi4 packages"
        ${MODULE_CLEANUP}

        spack load cmake@3.30.5/df4r5i6 llvm@main/2zfa3m7 openmpi@4.1.6/u4axpq2
        module load java sos_ompi
      </parameter>
      <parameter name="MODULE_LOAD" tag="!ompi4">
        echo "Loading ompi5 packages"
        ${MODULE_CLEANUP}

        spack load cmake@3.30.5/df4r5i6 llvm@main/2zfa3m7 openmpi@5.0.5/jvkspfx
        module load java sos_ompi
      </parameter>
      <parameter name="builds_folder" tag="ompi4">${jube_benchmark_home}/Tool_Builds/ompi4</parameter>
      <parameter name="builds_folder" tag="!ompi4">${jube_benchmark_home}/Tool_Builds/ompi5</parameter>
      <parameter name="MUST_DISABLE_TSAN_ONREPORT" export="true">1</parameter>
      <parameter name="TSAN_OPTIONS" export="true">log_path=stderr</parameter>
    </parameterset>
    <parameterset name="param_compilemode" duplicate="concat">
      <parameter name="tool" tag="base">base</parameter>
      <parameter name="tool" tag="must">must</parameter>
      <parameter name="tool" tag="must_filtered">must_filtered</parameter>
      <parameter name="tool" tag="cover">cover</parameter>
      <parameter name="tool" tag="cover_filtered">cover_filtered</parameter>
      <parameter name="def_wrapper_c">oshcc -lmpi</parameter>
      <parameter name="def_wrapper_cxx">oshc++ -lmpi</parameter>
      <parameter name="compiler_cxx" mode="python">
        {
          "base": "${def_wrapper_cxx}",
          "tsan": "${def_wrapper_cxx} -fsanitize=thread -mllvm -tsan-omit-by-pointer-capturing=0",
          "must": "${builds_folder}/MUST_Install/bin/must-tsan-cxx --wrap-target ${def_wrapper_cxx}",
          "must_filtered": "${jube_benchmark_home}/bench_data/must_filtered_compiler.sh '${builds_folder}/CoVer_Install/bin/clangContracts++' '${builds_folder}/MUST_Install/bin/must-tsan-cxx' '${def_wrapper_cxx}'",
          "cover": "${builds_folder}/CoVer_Install/bin/clangContracts++ --wrap-target ${def_wrapper_cxx} --predefined-contracts --instrument-contracts",
          "cover_filtered": "${builds_folder}/CoVer_Install/bin/clangContracts++ --wrap-target ${def_wrapper_cxx} --predefined-contracts --instrument-contracts=filtered",
        }["${tool}"]
      </parameter>
      <parameter name="compiler_c" mode="python">
        {
          "base": "${def_wrapper_c}",
          "tsan": "${def_wrapper_c} -fsanitize=thread -mllvm -tsan-omit-by-pointer-capturing=0",
          "must": "${builds_folder}/MUST_Install/bin/must-tsan-cc --wrap-target ${def_wrapper_c}",
          "must_filtered": "${jube_benchmark_home}/bench_data/must_filtered_compiler.sh '${builds_folder}/CoVer_Install/bin/clangContracts' '${builds_folder}/MUST_Install/bin/must-tsan-cc' '${def_wrapper_c}'",
          "cover": "${builds_folder}/CoVer_Install/bin/clangContracts --wrap-target ${def_wrapper_c} --predefined-contracts --instrument-contracts",
          "cover_filtered": "${builds_folder}/CoVer_Install/bin/clangContracts --wrap-target ${def_wrapper_c} --predefined-contracts --instrument-contracts=filtered",
        }["${tool}"]
      </parameter>
      <parameter name="base_runner" tag="!submit">mpiexec</parameter>
      <parameter name="base_runner" tag="submit">srun --mpi=pmix --overcommit</parameter>
      <parameter name="runner" mode="python">
        {
          "base": "${base_runner}",
          "tsan": "${base_runner}",
          "must": "${builds_folder}/MUST_Install/bin/mustrun --must:distributed --must:tsan --must:rma-race --must:output stdout --must:errorcode 0 --must:mpiexec \"${base_runner}\"",
          "must_filtered": "${builds_folder}/MUST_Install/bin/mustrun --must:nodl --must:tsan --must:rma-race --must:output stdout --must:errorcode 0 --must:mpiexec \"${base_runner}\" --must:detection-json-file contract_messages.json",
          "cover": "${base_runner}",
          "cover_filtered": "${base_runner}",
        }["${tool}"]
      </parameter>
    </parameterset>
    <step name="compile_cover">
      <use>param_environment</use>
      <do tag="cover|cover_filtered|must_filtered">
        ${MODULE_LOAD}
        cmake -S ${jube_benchmark_home}/Tool_Sources/CoVer -B ${builds_folder}/CoVer_Build -DCMAKE_INSTALL_PREFIX=${builds_folder}/CoVer_Install -DCMAKE_BUILD_TYPE=Release -DSHMEM_HEADER_PATH=${jube_benchmark_home}/bench_data/shmem.h
        cmake --build ${builds_folder}/CoVer_Build --target install -j 32
      </do>
    </step>

    <step name="compile_must">
      <use>param_environment</use>
      <do tag="must|must_filtered">
        ${MODULE_LOAD}
        if [ -d ${builds_folder}/MUST_Install ]; then
          exit 0
        fi
        cd ${jube_benchmark_home}/Tool_Sources/MUST
        git apply ${jube_benchmark_home}/bench_data/no_err_on_exit.patch
        cmake -S ${jube_benchmark_home}/Tool_Sources/MUST -B ${builds_folder}/MUST_Build -DCMAKE_INSTALL_PREFIX=${builds_folder}/MUST_Install -DCMAKE_BUILD_TYPE=Release -DENABLE_FORTRAN=OFF -DENABLE_TSAN=ON -DUSE_BACKWARD=OFF
        cmake --build ${builds_folder}/MUST_Build --target install -j 32
      </do>
    </step>
    <step name="tools_available" depend="compile_cover,compile_must" />
  </common_setup>
</jube>
