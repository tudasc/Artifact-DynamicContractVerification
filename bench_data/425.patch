From afd8252239460cbee989c8240c6f08f999164441 Mon Sep 17 00:00:00 2001
From: "felix.tomski" <tomski@itc.rwth-aachen.de>
Date: Mon, 27 Oct 2025 11:33:38 +0100
Subject: [PATCH] Fix compiltaion of delayed TSan messages without backward

---
 modules/TSan/Messages/TSanMessages.cpp | 21 +++++++++++++++++----
 modules/TSan/Messages/TSanMessages.h   |  6 ++++--
 2 files changed, 21 insertions(+), 6 deletions(-)

diff --git a/modules/TSan/Messages/TSanMessages.cpp b/modules/TSan/Messages/TSanMessages.cpp
index 409a810be..2529ad2cd 100644
--- a/modules/TSan/Messages/TSanMessages.cpp
+++ b/modules/TSan/Messages/TSanMessages.cpp
@@ -302,8 +302,17 @@ void TSanMessages::createLocation(
     }
 
     if (myDelayedReport) {
-        delayedLocations.emplace_back(
-            DelayedLocationInfo{locInfo, levels, stack_indices, stack_string, lId, pId});
+        delayedLocations.emplace_back(DelayedLocationInfo{
+            locInfo,
+            lId,
+            pId
+#ifdef ENABLE_STACKTRACE
+            ,
+            levels,
+            stack_indices,
+            stack_string
+#endif
+        });
     } else {
         (*myNewLocFunc)(
             pId,
@@ -489,11 +498,15 @@ auto TSanMessages::tsanReportRMA(const __tsan::ReportDescT<T>* const report) ->
         if (myDelayedReport) {
             delayedLocations.emplace_back(DelayedLocationInfo{
                 locations[i],
+                lIdList[i],
+                pId
+#ifdef ENABLE_STACKTRACE
+                ,
                 stackLevels[i],
                 indices[i],
                 locStrings[i],
-                lIdList[i],
-                pId});
+#endif
+            });
         } else {
             (*myNewLocFunc)(
                 pId,
diff --git a/modules/TSan/Messages/TSanMessages.h b/modules/TSan/Messages/TSanMessages.h
index b59a22e3c..915c8ff2d 100644
--- a/modules/TSan/Messages/TSanMessages.h
+++ b/modules/TSan/Messages/TSanMessages.h
@@ -34,11 +34,13 @@ namespace must
 
 struct DelayedLocationInfo {
     LocationInfo locInfo;
+    MustLocationId lId;
+    MustParallelId pId;
+#ifdef ENABLE_STACKTRACE
     int stack_levels;
     std::vector<int> stack_indices;
     std::string stack_string;
-    MustLocationId lId;
-    MustParallelId pId;
+#endif
 };
 
 struct DelayedMesssage {
