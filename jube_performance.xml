<jube>
  <benchmark name="StaticDynamicCorrectessBenchmark" outpath="results_performance_raw">
    <comment>Runs multiple proxy apps to measure runtime overhead</comment>

    <parameterset name="param_environment">
      <parameter name="CC" export="true">clang</parameter>
      <parameter name="OMPI_CC" export="true">clang</parameter>
      <parameter name="MPICH_CC" export="true">clang</parameter>
      <parameter name="CXX" export="true">clang++</parameter>
      <parameter name="OMPI_CXX" export="true">clang++</parameter>
      <parameter name="MPICH_CXX" export="true">clang++</parameter>
      <parameter name="MODULE_LOAD">
        module purge
        module use /home/yo30qaqy/modules
        module use /work/groups/da_sc/spack/spmodules/linux-rhel9-x86_64/
        module load mpich/5 java gcc/11.4
        spack load llvm@main
      </parameter>
    </parameterset>

    <parameterset name="param_compilemode">
      <parameter name="compile_mode">base,tsan,cover_full</parameter>
      <parameter name="compiler" mode="python">
        {
          "base": "mpicxx",
          "tsan": "mpicxx -fsanitize=thread -mllvm -tsan-omit-by-pointer-capturing=0",
          "cover_full": "${jube_benchmark_home}/builds/CoVer_Install/bin/clangContracts++ --predefined-contracts --instrument-contracts",
          "cover_filtered": "${jube_benchmark_home}/builds/CoVer_Install/bin/clangContracts++ --predefined-contracts --instrument-contracts=filtered",
        }["${compile_mode}"]
      </parameter>
    </parameterset>

    <parameterset name="param_runmode">
      <parameter name="nprocs">8</parameter>
    </parameterset>

    <fileset name="lulesh_src">
      <link>LULESH/</link>
    </fileset>
    <fileset name="cover_src">
      <link>CoVer/</link>
    </fileset>

    <step name="compile_cover">
      <use>param_environment</use>
      <use>cover_src</use>
      <do>
        ${MODULE_LOAD}
        cmake CoVer/ -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${jube_benchmark_home}/builds/CoVer_Install -B ${jube_benchmark_home}/builds/CoVer_Build -S ${jube_benchmark_home}/CoVer
        cmake --build ${jube_benchmark_home}/builds/CoVer_Build --target install
      </do>
    </step>

    <step name="compile_lulesh" depend="compile_cover" suffix="${compile_mode}">
      <use>param_environment</use>
      <use>lulesh_src</use>
      <use>param_compilemode</use>
      <do>
        ${MODULE_LOAD}
        cd LULESH
        make CXX="${compiler} -DUSE_MPI=1" CXXFLAGS="-g -O3 -I." LULESH_EXEC="lulesh_${compile_mode}"
        make clean <!-- Removes everything but the renamed executable -->
        cd ..
        mv LULESH/lulesh_${compile_mode} .
      </do>
    </step>

    <step name="run_lulesh" depend="compile_lulesh" suffix="${compile_mode}" iterations="1">
      <use>param_environment</use>
      <use>param_runmode</use>
      <do>
        ${MODULE_LOAD}
        mpiexec -np ${nprocs} ./compile_lulesh/lulesh_${compile_mode} -s 10 &gt; lulesh_stdout
      </do>
    </step>

    <!-- Regex pattern -->
    <patternset name="patterns">
      <pattern name="time" type="float">Elapsed time\s+=\s+$jube_pat_fp \(s\)</pattern>
    </patternset>

    <!-- Analyse -->
    <analyser name="analyse">
      <use>patterns</use>
      <analyse step="run_lulesh">
        <file>lulesh_stdout</file>
      </analyse>
    </analyser>

    <result>
      <use>analyse</use>
      <table name="result" style="pretty" sort="test_origin,test_name">
        <column title="Compile Mode">compile_mode</column>
        <column title="Time (Min)">time_min</column>
        <column title="Time (Max)">time_max</column>
        <column title="Time (Avg)">time_avg</column>
        <column title="Time (StdDev)">time_std</column>
      </table>
    </result>

  </benchmark>
</jube>
