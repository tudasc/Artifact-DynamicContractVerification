<jube>
  <benchmark name="CoVerDynamicPerfBench" outpath="results_performance_raw">
    <comment>Runs multiple proxy apps to measure runtime overhead</comment>

    <!-- Generic Setup -->
    <include from="jube_common.xml" path="common_setup/parameterset" />
    <include from="jube_common.xml" path="common_setup/step" />

    <parameterset name="param_proxyapp">
      <parameter name="proxy_app">lulesh,stencil,tealeaf</parameter>
      <parameter name="proxy_params" mode="python">
        {
          "lulesh": "-s 20",
          "stencil": "100 48000",
          "tealeaf": "",
        }["${proxy_app}"]
      </parameter>
      <parameter name="nprocs" mode="python">
        {
          "lulesh": "27",
          "stencil": "48",
          "tealeaf": "48",
        }["${proxy_app}"]
      </parameter>
    </parameterset>

    <fileset name="lulesh_src">
      <link>Performance_Sources/LULESH/</link>
    </fileset>
    <fileset name="stencil_src">
      <link>Performance_Sources/Stencil/</link>
    </fileset>
    <fileset name="tealeaf_src">
      <link>Performance_Sources/TeaLeaf/</link>
    </fileset>

    <step name="compile_lulesh" depend="tools_available" suffix="${tool}">
      <use>param_environment</use>
      <use>lulesh_src</use>
      <use>param_compilemode</use>
      <do>
        ${MODULE_LOAD}
        cd LULESH
        make CXX="${compiler_cxx} -DUSE_MPI=1" CXXFLAGS="-g -O3 -I." LULESH_EXEC="lulesh_${tool}"
        make clean <!-- Removes everything but the renamed executable -->
        cd ..
        mv LULESH/lulesh_${tool} .
      </do>
    </step>

    <step name="compile_stencil" depend="tools_available" suffix="${tool}">
      <use>param_environment</use>
      <use>stencil_src</use>
      <use>param_compilemode</use>
      <do>
        ${MODULE_LOAD}
        ${compiler_c} -g -O3 -DRADIUS=1 -DSTAR=1 -DDOUBLE=1 -lm Stencil/stencil.c -o stencil_${tool}
      </do>
    </step>

    <step name="compile_tealeaf" depend="tools_available" suffix="${tool}">
      <use>param_environment</use>
      <use>tealeaf_src</use>
      <use>param_compilemode</use>
      <do>
        ${MODULE_LOAD}
        mkdir build
        cd build
        CC="${compiler_c}" CXX="${compiler_cxx}" cmake ../TeaLeaf -DCMAKE_BUILD_TYPE=Release -DMODEL=serial -DENABLE_MPI=ON
        cmake --build .
        mv serial-tealeaf ../tealeaf_${tool}
      </do>
    </step>

    <step name="run_proxy_app" depend="compile_lulesh,compile_stencil,compile_tealeaf" suffix="${proxy_app}_${tool}" iterations="1">
      <use>param_environment</use>
      <use>param_proxyapp</use>
      <do>
        ${MODULE_LOAD}
        cp ${jube_benchmark_home}/bench_data/tea.{in,problems} .
        ${runner} -np ${nprocs} ./compile_${proxy_app}/${proxy_app}_${tool} ${proxy_params} &gt; proxy_out
        if [ "${proxy_app}" == "lulesh" ]; then
          cat proxy_out | grep "Elapsed time" | sed -r 's/Elapsed time\s*=\s*(.*)\s*\(s\)/\1/' &gt; time_parsed
        elif [ "${proxy_app}" == "stencil" ]; then
          cat proxy_out | grep "Total time" | sed -r 's/.*Total time\s*\(s\):\s*(.*)/\1/' &gt; time_parsed
        elif [ "${proxy_app}" == "tealeaf" ]; then
          cat proxy_out | grep Wallclock | tail -1 | sed -r 's/Wallclock:\s*(.*)s/\1/' &gt; time_parsed
        fi
      </do>
    </step>

    <!-- Regex pattern -->
    <patternset name="patterns">
      <pattern name="time" type="float">$jube_pat_fp</pattern>
    </patternset>

    <!-- Analyse -->
    <analyser name="analyse">
      <use>patterns</use>
      <analyse step="run_proxy_app">
        <file>time_parsed</file>
      </analyse>
    </analyser>

    <result>
      <use>analyse</use>
      <table name="result" style="pretty" sort="proxy_app,tool">
        <column title="Proxy App">proxy_app</column>
        <column title="Tool">tool</column>
        <column title="Time (Min)">time_min</column>
        <column title="Time (Max)">time_max</column>
        <column title="Time (Avg)">time_avg</column>
        <column title="Time (StdDev)">time_std</column>
      </table>
    </result>

  </benchmark>
</jube>
