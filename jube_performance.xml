<jube>
  <benchmark name="CoVerDynamicPerfBench" outpath="results_performance_raw">
    <comment>Runs multiple proxy apps to measure runtime overhead</comment>

    <!-- Generic Setup -->
    <include from="jube_common.xml" path="common_setup/parameterset" />
    <include from="jube_common.xml" path="common_setup/step" />

    <parameterset name="param_proxyapp">
      <parameter name="proxy_app">lulesh,stencil,tealeaf,miniweather</parameter>
      <parameter name="proxy_params" mode="python">
        {
          "lulesh": "-s 20",
          "stencil": "100 48000",
          "tealeaf": "",
          "miniweather": "",
        }["${proxy_app}"]
      </parameter>
    </parameterset>

    <parameterset name="param_exec">
      <parameter name="project_id">project02559</parameter>
      <parameter name="num_nodes" tag="!submit">1</parameter>
      <parameter name="num_nodes" tag="submit" mode="python">
        {
          "lulesh": "1,2,3",
          "stencil": "1,2,4",
          "tealeaf": "1,2,4",
          "miniweather": "1,2,4",
        }["${proxy_app}"]</parameter>
      <parameter name="nprocs" mode="python">
        {
          "lulesh": str((2+${num_nodes})**3),
          "stencil": str(${num_nodes}*48),
          "tealeaf": str(${num_nodes}*48),
          "miniweather": str(${num_nodes}*48),
        }["${proxy_app}"]
      </parameter>
      <parameter name="exec_cmd">${runner} -n ${nprocs} ./compile/${proxy_app}_${tool} ${proxy_params} &gt; proxy_out</parameter>
      <parameter name="exec_actual" tag="!submit">./submit.job</parameter>
      <parameter name="exec_actual" tag="submit">sbatch submit.job</parameter>
      <parameter name="postprocess" mode="python">
        {
          "lulesh": "cat proxy_out | grep 'Elapsed time' | sed -r 's/Elapsed time\\s*=\\s*(.*)\\s*\\(s\\)/\\1/' &gt; time_parsed; touch bench_done",
          "stencil": "cat proxy_out | grep 'Total time' | sed -r 's/.*Total time\\s*\\(s\\):\\s*(.*)/\\1/' &gt; time_parsed; touch bench_done",
          "tealeaf": "cat proxy_out | grep Wallclock | tail -1 | sed -r 's/Wallclock:\\s*(.*)s/\\1/' &gt; time_parsed; touch bench_done",
          "miniweather": "cat proxy_out | grep 'CPU Time' | sed -r 's/CPU Time: (.*) sec/\\1/' &gt; time_parsed; touch bench_done",
        }["${proxy_app}"]
      </parameter>
    </parameterset>

    <fileset name="lulesh_src">
      <link>Performance_Sources/LULESH/</link>
    </fileset>
    <fileset name="stencil_src">
      <link>Performance_Sources/Stencil/</link>
    </fileset>
    <fileset name="tealeaf_src">
      <link>Performance_Sources/TeaLeaf/</link>
    </fileset>
    <fileset name="miniweather_src">
      <link>Performance_Sources/miniWeather/</link>
    </fileset>

    <step name="compile" depend="tools_available" suffix="${proxy_app}_${tool}">
      <use>param_proxyapp</use>
      <use>param_environment</use>
      <use>param_compilemode</use>
      <use>lulesh_src</use>
      <use>stencil_src</use>
      <use>tealeaf_src</use>
      <use>miniweather_src</use>
      <do>
        ${MODULE_LOAD}
        if [[ "$proxy_app" == "lulesh" ]]; then
          ${compiler_cxx} -DUSE_MPI=1 -g -O3 -o lulesh_${tool} LULESH/*.cc
        elif [[ "$proxy_app" == "stencil" ]]; then
          ${compiler_c} -g -O3 -DRADIUS=1 -DSTAR=1 -DDOUBLE=1 -lm Stencil/stencil.c -o stencil_${tool}
        elif [[ "$proxy_app" == "tealeaf" ]]; then
          ${compiler_cxx} -g -O3 -o tealeaf_${tool} TeaLeaf/driver/*.cpp TeaLeaf/src/serial/*.cpp -I TeaLeaf/src/serial -I TeaLeaf/driver
        elif [[ "$proxy_app" == "miniweather" ]]; then
          ${compiler_cxx} -g -O3 -D_NX=150 -D_NZ=75 -D_SIM_TIME=10000 -D_OUT_FREQ=1000 -D_DATA_SPEC=DATA_SPEC_THERMAL -lm miniWeather/miniWeather_mpi.cpp -o miniweather_${tool}
        fi
      </do>
    </step>

    <substituteset name="substituteset_platform">
      <!-- Substitute files -->
      <iofile in="${jube_benchmark_home}/bench_data/submit.job.in" out="submit.job" />
      <!-- Substitute commands -->
      <sub source="#BENCHNAME#" dest="CoVerPerf_${proxy_app}_${nprocs}" />
      <sub source="#PROJECT_ID#" dest="${project_id}" />
      <sub source="#NUM_PROCS#" dest="${nprocs}" />
      <sub source="#NODES#" dest="${num_nodes}" />
      <sub source="#TIME_LIMIT#" dest="01:00:00" />
      <sub source="#STDOUTLOGFILE#" dest="job.out" />
      <sub source="#STDERRLOGFILE#" dest="job.err" />
      <sub source="#ENV#" dest="${jube_wp_envstr}" />
      <sub source="#MODULES#" dest="${MODULE_LOAD}" />
      <sub source="#EXEC_CMD#" dest="${exec_cmd}" />
      <sub source="#POSTPROCESS#" dest="${postprocess}" />
    </substituteset>

    <step name="run_proxy_app" depend="compile" suffix="${proxy_app}_${tool}" iterations="5">
      <use>param_environment</use>
      <use>param_proxyapp</use>
      <use>param_exec</use>
      <use>substituteset_platform</use>
      <do done_file="bench_done">
        if [ -e ./compile_${proxy_app}/contract_messages.json ]; then
          cp ./compile_${proxy_app}/contract_messages.json contract_messages.json
        fi
        cp ${jube_benchmark_home}/bench_data/tea.{in,problems} .
        chmod +x submit.job
        ${exec_actual}
      </do>
    </step>

    <!-- Regex pattern -->
    <patternset name="patterns">
      <pattern name="time" type="float">$jube_pat_fp</pattern>
    </patternset>

    <!-- Analyse -->
    <analyser name="analyse">
      <use>patterns</use>
      <analyse step="run_proxy_app">
        <file>time_parsed</file>
      </analyse>
    </analyser>

    <result>
      <use>analyse</use>
      <table name="result" style="pretty" sort="proxy_app,nprocs,tool">
        <column title="Proxy App">proxy_app</column>
        <column title="Processes">nprocs</column>
        <column title="Tool">tool</column>
        <column title="Time (Min)">time_min</column>
        <column title="Time (Max)">time_max</column>
        <column title="Time (Avg)">time_avg</column>
        <column title="Time (StdDev)">time_std</column>
      </table>
    </result>

  </benchmark>
</jube>
